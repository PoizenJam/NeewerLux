    {
      "hue": 280,
      "sat": 85
    },
    {
      "hue": 45,
      "sat": 90
    }
  ],
  "parts": [
    {
      "target": "@rim;@background;@practical",
      "drive": "beat",
      "colour": "beat",
      "chase": true
    }
  ]
}
