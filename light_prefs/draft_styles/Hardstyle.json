  "genres": [
    "hardstyle",
    "rawstyle",
    "raw hardstyle",
    "euphoric hardstyle",
    "hard dance",
    "happy hardcore",
    "uk hardcore",
    "gabber",
    "frenchcore",
    "hardcore techno",
    "jumpstyle"
  ],
  "palette": [
    {
      "hue": 0,
      "sat": 90
    },
    {
      "hue": 210,
      "sat": 5
    },
    {
      "hue": 30,
      "sat": 95
    },
    {
      "hue": 350,
      "sat": 70
    }
  ],
