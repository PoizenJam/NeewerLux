      "sound_modes": {
        "tags": [
          "punchy"
        ],
        "exclude": [
          "calm"
        ]
      }
    },
    "Build": {
      "behaviour": "build"
    },
    "Drop": {
      "behaviour": [
        "colour_bars",
        "hit_chase"
      ]
    },
    "Breakdown": {
      "behaviour": "hold"
    },
    "Outro": {
      "behaviour": "fade_down"
    }
  }
